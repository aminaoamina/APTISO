<!DOCTYPE html>
<html lang="en">
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" /><title>{{heading}}</title></head>
  <body style="margin:0;padding:32px 0;background:#f1f5f9;font-family:Arial,Helvetica,sans-serif;">
    <table role="presentation" width="100%"><tr><td align="center">
      <table role="presentation" width="100%" style="max-width:560px;background:#fff;border:1px solid #e2e8f0;border-radius:12px;"><tr><td style="padding:32px;">
        <h1 style="color:#0f172a;font-size:20px;margin:0 0 12px;">{{heading}}</h1>
        <p style="color:#475569;font-size:14px;line-height:1.6;margin:0 0 16px;">Hello {{recipientName}}, {{message}}</p>
        <table role="presentation" style="font-size:14px;color:#0f172a;margin:0 0 16px;">
          {{#each details}}<tr><td style="padding:4px 16px 4px 0;color:#64748b;vertical-align:top;">{{label}}</td><td style="padding:4px 0;white-space:pre-line;">{{value}}</td></tr>{{/each}}
        </table>
        <p style="margin:0;"><a href="{{link}}" style="display:inline-block;background:#f97316;color:#fff;text-decoration:none;padding:12px 24px;border-radius:8px;font-weight:600;">{{linkLabel}}</a></p>
      </td></tr></table>
    </td></tr></table>
  </body>
</html>
