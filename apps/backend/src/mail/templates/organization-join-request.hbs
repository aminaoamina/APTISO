<!DOCTYPE html>
<html lang="en">
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" /><title>APTISO organization invitation</title></head>
  <body style="margin:0;padding:32px 0;background:#f1f5f9;font-family:Arial,Helvetica,sans-serif;">
    <table role="presentation" width="100%"><tr><td align="center">
      <table role="presentation" width="100%" style="max-width:520px;background:#fff;border:1px solid #e2e8f0;border-radius:12px;"><tr><td style="padding:32px;">
        <h1 style="color:#0f172a;font-size:20px;">You have been invited to APTISO</h1>
        <p style="color:#475569;font-size:14px;line-height:1.6;">{{invitedByName}} invited you to join <strong>{{organizationName}}</strong>. Create an APTISO account to review and accept the organization request.</p>
        <p><a href="{{registerLink}}" style="display:inline-block;background:#2563eb;color:#fff;text-decoration:none;padding:12px 24px;border-radius:8px;font-weight:600;">Create APTISO account</a></p>
      </td></tr></table>
    </td></tr></table>
  </body>
</html>