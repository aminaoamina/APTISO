<!DOCTYPE html>
<html lang="en">
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" /><title>{{headline}}</title></head>
  <body style="margin:0;padding:32px 0;background:#f1f5f9;font-family:Arial,Helvetica,sans-serif;color:#0f172a;">
    <table role="presentation" width="100%"><tr><td align="center">
      <table role="presentation" width="100%" style="max-width:600px;background:#fff;border:1px solid #e2e8f0;border-radius:12px;overflow:hidden;">
        <!-- Header -->
        <tr><td style="background:#0f172a;padding:28px 32px;">
          <p style="margin:0;color:#f97316;font-size:12px;font-weight:700;letter-spacing:1px;text-transform:uppercase;">APTISO weekly digest · {{week}}</p>
          <h1 style="margin:8px 0 0;color:#fff;font-size:22px;line-height:1.3;">{{headline}}</h1>
          <p style="margin:8px 0 0;color:#cbd5e1;font-size:14px;">Hello {{firstName}}, here is your week.</p>
        </td></tr>

        {{#each projects}}
        <!-- Project -->
        <tr><td style="padding:28px 32px 8px;">
          <table role="presentation" width="100%"><tr>
            <td><a href="{{link}}" style="color:#0f172a;font-size:18px;font-weight:700;text-decoration:none;">{{name}}</a>
              <div style="color:#64748b;font-size:13px;margin-top:2px;">{{phase}} · you are {{role}}</div></td>
            <td align="right" style="color:#f97316;font-size:20px;font-weight:700;white-space:nowrap;">{{progress}}%</td>
          </tr></table>
          <div style="background:#e2e8f0;border-radius:4px;height:8px;margin:10px 0 16px;"><div style="background:#f97316;border-radius:4px;height:8px;width:{{progress}}%;"></div></div>

          <table role="presentation" width="100%" style="border-collapse:separate;border-spacing:6px 0;margin:0 -6px 16px;"><tr>
            <td width="20%" style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;padding:10px 4px;text-align:center;"><div style="font-size:20px;font-weight:700;">{{stats.teamTasks}}</div><div style="font-size:11px;color:#64748b;">team tasks done</div></td>
            <td width="20%" style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;padding:10px 4px;text-align:center;"><div style="font-size:20px;font-weight:700;">{{stats.teamSteps}}</div><div style="font-size:11px;color:#64748b;">steps done</div></td>
            <td width="20%" style="background:#fff7ed;border:1px solid #fed7aa;border-radius:8px;padding:10px 4px;text-align:center;"><div style="font-size:20px;font-weight:700;">{{stats.yourDone}}</div><div style="font-size:11px;color:#64748b;">done by you</div></td>
            <td width="20%" style="background:#fff7ed;border:1px solid #fed7aa;border-radius:8px;padding:10px 4px;text-align:center;"><div style="font-size:20px;font-weight:700;">{{stats.yourOpen}}</div><div style="font-size:11px;color:#64748b;">open for you</div></td>
            <td width="20%" style="background:{{#if stats.yourOverdue}}#fef2f2{{else}}#fff7ed{{/if}};border:1px solid {{#if stats.yourOverdue}}#fecaca{{else}}#fed7aa{{/if}};border-radius:8px;padding:10px 4px;text-align:center;"><div style="font-size:20px;font-weight:700;color:{{#if stats.yourOverdue}}#dc2626{{else}}#0f172a{{/if}};">{{stats.yourOverdue}}</div><div style="font-size:11px;color:#64748b;">overdue</div></td>
          </tr></table>

          <p style="margin:0 0 4px;font-size:12px;font-weight:700;color:#64748b;text-transform:uppercase;">The team</p>
          <p style="margin:0 0 14px;font-size:14px;line-height:1.6;">{{team}}</p>
          <p style="margin:0 0 4px;font-size:12px;font-weight:700;color:#64748b;text-transform:uppercase;">Your week</p>
          <p style="margin:0 0 8px;font-size:14px;line-height:1.6;">{{you}}</p>
        </td></tr>
        <tr><td style="padding:0 32px;"><div style="border-top:1px solid #e2e8f0;"></div></td></tr>
        {{/each}}

        {{#if nextSteps.length}}
        <!-- Next steps -->
        <tr><td style="padding:24px 32px 8px;">
          <h2 style="margin:0 0 12px;font-size:16px;">Your next steps</h2>
          {{#each nextSteps}}
          <table role="presentation" width="100%" style="margin:0 0 10px;border:1px solid #e2e8f0;border-radius:8px;"><tr>
            <td style="padding:12px 14px;">
              <div style="font-size:14px;font-weight:600;">{{title}}</div>
              <div style="font-size:12px;color:#64748b;margin-top:2px;">{{project}}{{#if why}} · {{why}}{{/if}}</div>
            </td>
            <td align="right" style="padding:12px 14px;white-space:nowrap;"><a href="{{link}}" style="display:inline-block;background:#f97316;color:#fff;text-decoration:none;padding:8px 14px;border-radius:6px;font-size:13px;font-weight:600;">Open</a></td>
          </tr></table>
          {{/each}}
        </td></tr>
        {{/if}}

        <!-- Tip -->
        <tr><td style="padding:16px 32px;">
          <div style="background:#eff6ff;border-left:4px solid #3b82f6;border-radius:6px;padding:14px 16px;">
            <div style="font-size:12px;font-weight:700;color:#1d4ed8;text-transform:uppercase;margin-bottom:4px;">Tip of the week</div>
            <div style="font-size:14px;line-height:1.6;color:#1e3a8a;">{{tip}}</div>
          </div>
        </td></tr>

        <!-- Encouragement -->
        <tr><td style="padding:8px 32px 28px;">
          <p style="margin:0;font-size:15px;line-height:1.6;font-style:italic;color:#334155;">{{encouragement}}</p>
        </td></tr>

        <!-- Footer -->
        <tr><td style="background:#f8fafc;border-top:1px solid #e2e8f0;padding:16px 32px;font-size:12px;color:#94a3b8;line-height:1.5;">
          {{#if byAi}}Written with AI from your project records; the numbers come straight from APTISO.{{else}}Summary from your project records.{{/if}}
          You receive this every Monday. <a href="{{settingsLink}}" style="color:#64748b;">Turn off the weekly digest</a> in your profile.
        </td></tr>
      </table>
    </td></tr></table>
  </body>
</html>
