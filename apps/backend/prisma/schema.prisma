// ============================================================
// APTISO - Prisma schema (Sprint 1)
// Reference entity model: Documents/entity-diagram.md
// Naming: models PascalCase, columns snake_case (@map)
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum OrganizationRole {
  ORG_OWNER
  ORG_ADMIN
  ORG_MEMBER
}

enum ProjectRole {
  PROJECT_LEAD
  PROJECT_AUDITOR
  PROJECT_MEMBER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum IsoRole {
  TOP_MANAGEMENT
  INFORMATION_SECURITY_MANAGER
  ASSET_OWNER
  DEPARTMENT_HEAD
  IT_ADMINISTRATOR
  INTERNAL_AUDITOR
  EMPLOYEE
}

enum RequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum OrganizationJoinRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum NotificationType {
  ORGANIZATION_JOIN_REQUEST
  TASK_ASSIGNED
  TASK_COMPLETED
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  CERTIFIED
  ON_HOLD
}

enum ProjectPhaseStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum VerificationStatus {
  PENDING
  VERIFIED
  EXPIRED
}

enum PasswordResetStatus {
  PENDING
  USED
  EXPIRED
}

enum AuditAction {
  USER_REGISTERED
  USER_DELETED
  USER_LOGIN
  USER_LOGOUT
  TOKEN_REFRESHED
  EMAIL_VERIFIED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  PASSWORD_CHANGED
  PROFILE_UPDATED
  ORGANIZATION_CREATED
  ORGANIZATION_UPDATED
  ORGANIZATION_DELETED
  PROJECT_CREATED
  PROJECT_UPDATED
  PROJECT_DELETED
  MEMBER_INVITED
  INVITATION_ACCEPTED
  INVITATION_REVOKED
  MEMBER_ADDED
  MEMBER_REMOVED
  MEMBER_ROLE_CHANGED
  PROJECT_MEMBER_ADDED
  PROJECT_MEMBER_REMOVED
  PROJECT_MEMBER_ROLE_CHANGED
  PHASE_UPDATED
  STEP_COMPLETED
  DOCUMENT_CREATED
  DOCUMENT_UPDATED
  DOCUMENT_PUBLISHED
  TASK_ASSIGNED
  TASK_COMPLETED
}

// ============================================================
// USERS & INTERNAL AUTH TABLES
// ============================================================

model User {
  id                String    @id @default(uuid()) @db.Uuid
  email             String    @unique @db.VarChar(150)
  first_name        String    @db.VarChar(100)
  last_name         String    @db.VarChar(100)
  password_hash     String
  avatar_url        String?   @db.VarChar(500)
  bio               String?   @db.Text
  job_title         String?   @db.VarChar(150)
  timezone          String?   @default("UTC") @db.VarChar(50)
  is_active         Boolean   @default(false)
  is_email_verified Boolean   @default(false)
  last_login        DateTime? @db.Timestamp(6)
  created_at        DateTime  @default(now()) @db.Timestamp(6)
  updated_at        DateTime  @updatedAt @db.Timestamp(6)

  // Relations
  organization_memberships           OrganizationMember[]
  project_memberships                ProjectMember[]
  organizations_created              Organization[]            @relation("OrganizationsCreated")
  projects_created                   ComplianceProject[]       @relation("ProjectsCreated")
  invitations_sent                   Invitation[]              @relation("InvitationsSent")
  invitations_accepted               Invitation[]              @relation("InvitationsAccepted")
  member_add_requests_sent           MemberAddRequest[]        @relation("MemberAddRequestsSent")
  member_add_requests_reviewed       MemberAddRequest[]        @relation("MemberAddRequestsReviewed")
  sessions                           Session[]
  email_verifications                EmailVerification[]
  password_resets                    PasswordReset[]
  audit_logs                         AuditLog[]
  organization_join_requests         OrganizationJoinRequest[] @relation("JoinRequestsForUser")
  organization_join_requests_created OrganizationJoinRequest[] @relation("JoinRequestsCreated")
  notifications                      Notification[]
  documents_created                  DocumentInstance[]        @relation("DocumentsCreated")
  doc_last_edited                    DocumentInstance[]        @relation("DocLastEdited")
  doc_owner                          DocumentInstance[]        @relation("DocOwner")
  doc_reviewer                       DocumentInstance[]        @relation("DocReviewer")
  doc_approver                       DocumentInstance[]        @relation("DocApprover")
  doc_versions_published            DocumentVersion[]         @relation("DocVersionPublisher")
  tasks_assigned_to                  TaskAssignment[]          @relation("TasksAssignedTo")
  tasks_assigned_by                  TaskAssignment[]          @relation("TasksAssignedBy")
  requirements_responsible           Requirement[]
  risks_owned                        RiskItem[]             @relation("RiskOwners")
  risk_assets_owned                  RiskItem[]             @relation("RiskAssetOwners")
  risk_decisions                     RiskItem[]             @relation("RiskDecisions")

  @@index([email])
  @@map("users")
}

model Session {
  id                 String   @id @default(uuid()) @db.Uuid
  user_id            String   @db.Uuid
  refresh_token_hash String   @unique
  device_name        String?  @db.VarChar(100)
  device_type        String?  @db.VarChar(50)
  ip_address         String?  @db.VarChar(45)
  user_agent         String?
  is_active          Boolean  @default(true)
  last_activity      DateTime @default(now()) @db.Timestamp(6)
  expires_at         DateTime @db.Timestamp(6)
  created_at         DateTime @default(now()) @db.Timestamp(6)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([refresh_token_hash])
  @@index([expires_at])
  @@map("sessions")
}

model EmailVerification {
  id                        String             @id @default(uuid()) @db.Uuid
  user_id                   String             @db.Uuid
  hashed_verification_token String             @unique
  status                    VerificationStatus @default(PENDING)
  expires_at                DateTime           @db.Timestamp(6)
  created_at                DateTime           @default(now()) @db.Timestamp(6)
  updated_at                DateTime           @updatedAt @db.Timestamp(6)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([hashed_verification_token])
  @@map("email_verifications")
}

model PasswordReset {
  id         String              @id @default(uuid()) @db.Uuid
  user_id    String              @db.Uuid
  reset_code String              @db.VarChar(5)
  status     PasswordResetStatus @default(PENDING)
  expires_at DateTime            @db.Timestamp(6)
  attempts   Int                 @default(0)
  created_at DateTime            @default(now()) @db.Timestamp(6)
  updated_at DateTime            @updatedAt @db.Timestamp(6)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, reset_code])
  @@index([user_id, status])
  @@map("password_resets")
}

// ============================================================
// ORGANIZATIONS (multi-tenant)
// ============================================================

model Organization {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(150)
  description String?  @db.Text
  industry    String?  @db.VarChar(100)
  created_by  String   @db.Uuid
  created_at  DateTime @default(now()) @db.Timestamp(6)
  updated_at  DateTime @updatedAt @db.Timestamp(6)

  creator                    User                      @relation("OrganizationsCreated", fields: [created_by], references: [id])
  members                    OrganizationMember[]
  projects                   ComplianceProject[]
  invitations                Invitation[]
  member_add_requests        MemberAddRequest[]
  organization_join_requests OrganizationJoinRequest[]
  notifications              Notification[]

  @@index([name])
  @@map("organizations")
}

model OrganizationMember {
  id              String           @id @default(uuid()) @db.Uuid
  organization_id String           @db.Uuid
  user_id         String           @db.Uuid
  role            OrganizationRole @default(ORG_MEMBER)
  created_at      DateTime         @default(now()) @db.Timestamp(6)
  updated_at      DateTime         @updatedAt @db.Timestamp(6)

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([organization_id, user_id])
  @@index([user_id])
  @@map("organization_members")
}

// ============================================================
// COMPLIANCE PROJECTS (ISO 27001)
// ============================================================

enum FrameworkStatus {
  AVAILABLE
  COMING_SOON
}

model ComplianceFramework {
  id          String          @id @default(uuid()) @db.Uuid
  code        String          @unique @db.VarChar(50)
  name        String          @db.VarChar(150)
  description String?         @db.Text
  version     String?         @db.VarChar(50)
  status      FrameworkStatus @default(COMING_SOON)
  created_at  DateTime        @default(now()) @db.Timestamp(6)
  updated_at  DateTime        @updatedAt @db.Timestamp(6)

  projects ComplianceProject[]

  @@map("compliance_frameworks")
}

model ComplianceProject {
  id                      String        @id @default(uuid()) @db.Uuid
  organization_id         String        @db.Uuid
  name                    String        @db.VarChar(150)
  description             String?       @db.Text
  status                  ProjectStatus @default(PLANNING)
  start_date              DateTime?     @db.Timestamp(6)
  target_date             DateTime?     @db.Timestamp(6)
  compliance_framework_id String        @db.Uuid
  created_by              String        @db.Uuid
  created_at              DateTime      @default(now()) @db.Timestamp(6)
  updated_at              DateTime      @updatedAt @db.Timestamp(6)

  organization         Organization        @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  creator              User                @relation("ProjectsCreated", fields: [created_by], references: [id])
  compliance_framework ComplianceFramework @relation(fields: [compliance_framework_id], references: [id])
  members              ProjectMember[]
  phases               ProjectPhase[]
  invitations          Invitation[]
  member_add_requests  MemberAddRequest[]
  task_assignments     TaskAssignment[]
  notifications        Notification[]

  @@index([organization_id])
  @@index([status])
  @@map("compliance_projects")
}

model ProjectMember {
  id          String      @id @default(uuid()) @db.Uuid
  project_id  String      @db.Uuid
  user_id     String      @db.Uuid
  privilege   ProjectRole @default(PROJECT_MEMBER) @map("role")
  custom_role String?     @db.VarChar(150)
  joined_at   DateTime    @default(now()) @db.Timestamp(6)
  created_at  DateTime    @default(now()) @db.Timestamp(6)

  project   ComplianceProject      @relation(fields: [project_id], references: [id], onDelete: Cascade)
  user      User                   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  iso_roles ProjectMemberIsoRole[]

  @@unique([project_id, user_id])
  @@index([user_id])
  @@map("project_members")
}

model ProjectMemberIsoRole {
  id                String   @id @default(uuid()) @db.Uuid
  project_member_id String   @db.Uuid
  iso_role          IsoRole
  created_at        DateTime @default(now()) @db.Timestamp(6)

  project_member ProjectMember @relation(fields: [project_member_id], references: [id], onDelete: Cascade)

  @@unique([project_member_id, iso_role])
  @@map("project_member_iso_roles")
}

model MemberAddRequest {
  id              String        @id @default(uuid()) @db.Uuid
  organization_id String        @db.Uuid
  project_id      String        @db.Uuid
  requested_by    String        @db.Uuid
  invited_email   String        @db.VarChar(150)
  privilege       ProjectRole   @default(PROJECT_MEMBER)
  message         String?       @db.Text
  status          RequestStatus @default(PENDING)
  reviewed_by     String?       @db.Uuid
  reviewed_at     DateTime?     @db.Timestamp(6)
  created_at      DateTime      @default(now()) @db.Timestamp(6)
  updated_at      DateTime      @updatedAt @db.Timestamp(6)

  organization Organization      @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  project      ComplianceProject @relation(fields: [project_id], references: [id], onDelete: Cascade)
  requester    User              @relation("MemberAddRequestsSent", fields: [requested_by], references: [id], onDelete: Cascade)
  reviewer     User?             @relation("MemberAddRequestsReviewed", fields: [reviewed_by], references: [id], onDelete: SetNull)

  @@index([organization_id])
  @@index([project_id])
  @@index([status])
  @@map("member_add_requests")
}

model OrganizationJoinRequest {
  id                String                        @id @default(uuid()) @db.Uuid
  organization_id   String                        @db.Uuid
  requested_by      String                        @db.Uuid
  invited_email     String                        @db.VarChar(150)
  requested_user_id String?                       @db.Uuid
  role              OrganizationRole              @default(ORG_MEMBER)
  status            OrganizationJoinRequestStatus @default(PENDING)
  created_at        DateTime                      @default(now()) @db.Timestamp(6)
  updated_at        DateTime                      @updatedAt @db.Timestamp(6)

  organization   Organization   @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  requester      User           @relation("JoinRequestsCreated", fields: [requested_by], references: [id], onDelete: Cascade)
  requested_user User?          @relation("JoinRequestsForUser", fields: [requested_user_id], references: [id], onDelete: SetNull)
  notifications  Notification[]

  @@index([invited_email, status])
  @@index([requested_user_id, status])
  @@map("organization_join_requests")
}

model Notification {
  id                 String           @id @default(uuid()) @db.Uuid
  user_id            String           @db.Uuid
  organization_id    String?          @db.Uuid
  join_request_id    String?          @db.Uuid
  task_assignment_id String?          @db.Uuid
  project_id         String?          @db.Uuid
  type               NotificationType
  read_at            DateTime?        @db.Timestamp(6)
  created_at         DateTime         @default(now()) @db.Timestamp(6)

  user            User                     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  organization    Organization?            @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  join_request    OrganizationJoinRequest? @relation(fields: [join_request_id], references: [id], onDelete: Cascade)
  task_assignment TaskAssignment?          @relation(fields: [task_assignment_id], references: [id], onDelete: Cascade)
  project         ComplianceProject?       @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@index([user_id, read_at])
  @@map("notifications")
}

model ProjectPhase {
  id           String             @id @default(uuid()) @db.Uuid
  project_id   String             @db.Uuid
  name         String             @db.VarChar(150)
  description  String?            @db.Text
  order        Int
  status       ProjectPhaseStatus @default(NOT_STARTED)
  started_at   DateTime?          @db.Timestamp(6)
  completed_at DateTime?          @db.Timestamp(6)
  created_at   DateTime           @default(now()) @db.Timestamp(6)
  updated_at   DateTime           @updatedAt @db.Timestamp(6)

  project ComplianceProject @relation(fields: [project_id], references: [id], onDelete: Cascade)

  steps ProjectStep[]

  @@unique([project_id, order])
  @@index([project_id])
  @@map("project_phases")
}

// ============================================================
// IMPLEMENTATION STEPS & GUIDED DOCUMENTS
// ============================================================

enum StepType {
  EDUCATIONAL
  DOCUMENT
  REGISTER
}

enum StepStatus {
  NOT_STARTED
  COMPLETED
}

enum RequirementType {
  CONTRACTUAL
  LEGAL_REGULATORY
  OTHER
}

enum ComplianceStatus {
  NON_COMPLIANT
  COMPLIANT
}

enum AssetCategory {
  INFRASTRUCTURE
  IT_COMMUNICATION
  SOFTWARE_DATABASE
  DOCUMENTS_DATA
  HUMAN_RESOURCES
  THIRD_PARTY
}

enum ThreatCategory {
  FORCE_MAJEURE
  INTERNAL_OVERSIGHT
  UNINTENTIONAL_MISTAKE
  MALICIOUS_INTENT
  TECHNICAL_ERROR
}

enum RiskStatus {
  NEW
  EDITED
  APPROVED
}

enum RiskAcceptability {
  ACCEPTABLE
  NOT_ACCEPTABLE
}

enum TreatmentOption {
  DECREASE
  TRANSFER
  AVOID
  ACCEPT
}

enum RiskApprovalDecision {
  PENDING
  APPROVED
  REJECTED
}

enum TemplateInputType {
  TEXT
  LONGTEXT
  PERSON
  SELECT
  DATE
}

enum DocumentStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  PUBLISHED
}

enum TaskType {
  WORK_ON_DOCUMENT
  REVIEW_DOCUMENT
  APPROVE_DOCUMENT
  AWARENESS_TASK
  TRAINING_TASK
  HR_REQUEST
  FINANCE_REQUEST
  TECHNOLOGY_REQUEST
  RISK_REVIEW
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

model ProjectStep {
  id              String     @id @default(uuid()) @db.Uuid
  phase_id        String     @db.Uuid
  key             String     @db.VarChar(100)
  title           String     @db.VarChar(200)
  purpose         String?    @db.Text
  type            StepType   @default(EDUCATIONAL)
  order           Int
  status          StepStatus @default(NOT_STARTED)
  completed_at    DateTime?  @db.Timestamp(6)
  metadata_json   Json?
  completion_data Json?
  created_at      DateTime   @default(now()) @db.Timestamp(6)
  updated_at      DateTime   @updatedAt @db.Timestamp(6)

  phase             ProjectPhase      @relation(fields: [phase_id], references: [id], onDelete: Cascade)
  document_instance DocumentInstance?
  task_assignments  TaskAssignment[]
  requirements      Requirement[]
  risk_assets       RiskAsset[]
  risk_vulnerabilities RiskVulnerability[]
  risk_threats      RiskThreat[]
  risk_asset_vuln_links RiskAssetVulnLink[]
  risk_vuln_threat_links RiskVulnThreatLink[]
  risks             RiskItem[]

  @@unique([phase_id, key])
  @@unique([phase_id, order])
  @@index([phase_id])
  @@map("project_steps")
}

model DocumentTemplate {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(200)
  version     String   @default("1.0") @db.VarChar(20)
  description String?  @db.Text
  created_at  DateTime @default(now()) @db.Timestamp(6)
  updated_at  DateTime @updatedAt @db.Timestamp(6)

  questions TemplateQuestion[]
  instances DocumentInstance[]

  @@map("document_templates")
}

model TemplateQuestion {
  id          String            @id @default(uuid()) @db.Uuid
  template_id String            @db.Uuid
  key         String            @db.VarChar(80)
  label       String            @db.VarChar(200)
  help_text   String?           @db.Text
  input_type  TemplateInputType @default(TEXT)
  required    Boolean           @default(false)
  options     Json?
  wizard_page Int
  order       Int
  created_at  DateTime          @default(now()) @db.Timestamp(6)
  updated_at  DateTime          @updatedAt @db.Timestamp(6)

  template DocumentTemplate @relation(fields: [template_id], references: [id], onDelete: Cascade)

  @@unique([template_id, key])
  @@index([template_id, wizard_page, order])
  @@map("template_questions")
}

model DocumentInstance {
  id              String         @id @default(uuid()) @db.Uuid
  template_id     String         @db.Uuid
  step_id         String?        @unique @db.Uuid
  title           String         @db.VarChar(250)
  status          DocumentStatus @default(DRAFT)
  version         String         @default("0.1") @db.VarChar(20)
  content         Json
  answers         Json?
  created_by      String         @db.Uuid
  last_edited_by  String?        @db.Uuid
  owner_id        String?        @db.Uuid
  reviewer_id     String?        @db.Uuid
  approver_id     String?        @db.Uuid
  update_interval Int?
  deadline        DateTime?      @db.Timestamp(6)
  created_at      DateTime       @default(now()) @db.Timestamp(6)
  updated_at      DateTime       @updatedAt @db.Timestamp(6)

  template DocumentTemplate @relation(fields: [template_id], references: [id])
  step     ProjectStep?     @relation(fields: [step_id], references: [id], onDelete: Cascade)
  creator  User             @relation("DocumentsCreated", fields: [created_by], references: [id])
  last_editor User?         @relation("DocLastEdited", fields: [last_edited_by], references: [id], onDelete: SetNull)
  owner    User?            @relation("DocOwner", fields: [owner_id], references: [id], onDelete: SetNull)
  reviewer User?            @relation("DocReviewer", fields: [reviewer_id], references: [id], onDelete: SetNull)
  approver User?            @relation("DocApprover", fields: [approver_id], references: [id], onDelete: SetNull)

  task_assignments TaskAssignment[]
  versions         DocumentVersion[]

  @@index([template_id])
  @@index([created_by])
  @@map("document_instances")
}

// ============================================================
// DOCUMENT VERSIONS & LIBRARY
// ============================================================

model DocumentVersion {
  id              String   @id @default(uuid()) @db.Uuid
  document_id     String   @db.Uuid
  version         String   @db.VarChar(20)
  content         Json
  pdf_data        Bytes?
  published_at    DateTime @default(now()) @db.Timestamp(6)
  published_by    String   @db.Uuid
  notes           String?  @db.VarChar(500)

  document DocumentInstance @relation(fields: [document_id], references: [id], onDelete: Cascade)
  publisher User            @relation("DocVersionPublisher", fields: [published_by], references: [id])

  @@index([document_id])
  @@map("document_versions")
}

// ============================================================
// TASK ASSIGNMENTS & WORKFLOW
// ============================================================

model TaskAssignment {
  id                   String     @id @default(uuid()) @db.Uuid
  project_id           String     @db.Uuid
  step_id              String?    @db.Uuid
  document_instance_id String?    @db.Uuid
  assigned_to          String     @db.Uuid
  assigned_by          String     @db.Uuid
  type                 TaskType
  status               TaskStatus @default(PENDING)
  deadline             DateTime?  @db.Timestamp(6)
  completed_at         DateTime?  @db.Timestamp(6)
  notes                String?    @db.Text
  created_at           DateTime   @default(now()) @db.Timestamp(6)

  project  ComplianceProject @relation(fields: [project_id], references: [id], onDelete: Cascade)
  step     ProjectStep?      @relation(fields: [step_id], references: [id], onDelete: SetNull)
  document DocumentInstance? @relation(fields: [document_instance_id], references: [id], onDelete: SetNull)
  assignee User              @relation("TasksAssignedTo", fields: [assigned_to], references: [id], onDelete: Cascade)
  assigner User              @relation("TasksAssignedBy", fields: [assigned_by], references: [id], onDelete: Cascade)

  notifications Notification[]

  @@index([assigned_to, status])
  @@index([project_id])
  @@index([step_id])
  @@map("task_assignments")
}

// ============================================================
// INVITATIONS (APT-012 / APT-018)
// ============================================================

model Invitation {
  id              String           @id @default(uuid()) @db.Uuid
  organization_id String           @db.Uuid
  project_id      String?          @db.Uuid
  invited_by      String           @db.Uuid
  invited_email   String           @db.VarChar(150)
  role            ProjectRole      @default(PROJECT_MEMBER)
  message         String?          @db.Text
  invite_code     String           @unique @db.VarChar(64)
  hashed_token    String           @unique
  status          InvitationStatus @default(PENDING)
  accepted_by     String?          @db.Uuid
  accepted_at     DateTime?        @db.Timestamp(6)
  expires_at      DateTime         @db.Timestamp(6)
  created_at      DateTime         @default(now()) @db.Timestamp(6)
  updated_at      DateTime         @updatedAt @db.Timestamp(6)

  organization Organization       @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  project      ComplianceProject? @relation(fields: [project_id], references: [id], onDelete: SetNull)
  inviter      User               @relation("InvitationsSent", fields: [invited_by], references: [id], onDelete: Cascade)
  acceptor     User?              @relation("InvitationsAccepted", fields: [accepted_by], references: [id], onDelete: SetNull)

  @@index([invited_email])
  @@index([status])
  @@index([expires_at])
  @@map("invitations")
}

// ============================================================
// AUDIT TRAIL (ActivityLog from entity-diagram)
// ============================================================

model AuditLog {
  id          String      @id @default(uuid()) @db.Uuid
  user_id     String?     @db.Uuid
  action      AuditAction
  entity_type String      @db.VarChar(50)
  entity_id   String?     @db.Uuid
  details     Json?
  ip_address  String?     @db.VarChar(45)
  user_agent  String?
  created_at  DateTime    @default(now()) @db.Timestamp(6)

  user User? @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([user_id])
  @@index([action])
  @@index([created_at])
  @@map("audit_logs")
}

model Requirement {
  id                   String            @id @default(uuid()) @db.Uuid
  step_id              String            @db.Uuid
  requirement_type     RequirementType
  status               ComplianceStatus  @default(NON_COMPLIANT)
  interested_party     String            @db.VarChar(500)
  description          String            @db.Text
  responsible_person_id String           @db.Uuid
  related_area         String?           @db.VarChar(500)
  deadline             DateTime?         @db.Timestamp(6)

  // Contractual & Other
  document_stipulating String?           @db.Text
  date_of_document     DateTime?         @db.Timestamp(6)

  // Legal/Regulatory
  valid_from           DateTime?         @db.Timestamp(6)
  country              String?           @db.VarChar(200)
  state                String?           @db.VarChar(200)
  link                 String?           @db.Text
  law_regulation_name  String?           @db.VarChar(500)

  created_at           DateTime          @default(now()) @db.Timestamp(6)
  updated_at           DateTime          @updatedAt @db.Timestamp(6)

  step                ProjectStep      @relation(fields: [step_id], references: [id], onDelete: Cascade)
  responsible_person  User             @relation(fields: [responsible_person_id], references: [id], onDelete: Restrict)

  @@index([step_id])
  @@map("requirements")
}

// ============================================================
// RISK REGISTER (Phase 2 / Step 2)
// ============================================================

model RiskAsset {
  id        String        @id @default(uuid()) @db.Uuid
  step_id   String        @db.Uuid
  name      String        @db.VarChar(300)
  category  AssetCategory
  is_custom Boolean       @default(false)
  order     Int
  created_at DateTime    @default(now()) @db.Timestamp(6)

  step ProjectStep  @relation(fields: [step_id], references: [id], onDelete: Cascade)
  vuln_links RiskAssetVulnLink[]
  threat_links RiskVulnThreatLink[]
  risks RiskItem[]

  @@unique([step_id, name, category])
  @@index([step_id])
  @@map("risk_assets")
}

model RiskVulnerability {
  id                 String       @id @default(uuid()) @db.Uuid
  step_id            String       @db.Uuid
  name               String       @db.VarChar(300)
  category           AssetCategory
  applicable_controls Json?       @db.Json
  is_custom          Boolean      @default(false)
  created_at         DateTime     @default(now()) @db.Timestamp(6)

  step ProjectStep  @relation(fields: [step_id], references: [id], onDelete: Cascade)
  asset_links RiskAssetVulnLink[]
  threat_links RiskVulnThreatLink[]
  risks RiskItem[]

  @@unique([step_id, name, category])
  @@index([step_id])
  @@map("risk_vulnerabilities")
}

model RiskThreat {
  id                 String       @id @default(uuid()) @db.Uuid
  step_id            String       @db.Uuid
  name               String       @db.VarChar(300)
  threat_category    ThreatCategory
  applicable_controls Json?       @db.Json
  is_custom          Boolean      @default(false)
  created_at         DateTime     @default(now()) @db.Timestamp(6)

  step ProjectStep  @relation(fields: [step_id], references: [id], onDelete: Cascade)
  vuln_links RiskVulnThreatLink[]
  risks RiskItem[]

  @@unique([step_id, name, threat_category])
  @@index([step_id])
  @@map("risk_threats")
}

model RiskAssetVulnLink {
  id              String          @id @default(uuid()) @db.Uuid
  step_id         String          @db.Uuid
  asset_id        String          @db.Uuid
  vulnerability_id String          @db.Uuid
  created_at      DateTime        @default(now()) @db.Timestamp(6)

  step           ProjectStep      @relation(fields: [step_id], references: [id], onDelete: Cascade)
  asset          RiskAsset        @relation(fields: [asset_id], references: [id], onDelete: Cascade)
  vulnerability  RiskVulnerability @relation(fields: [vulnerability_id], references: [id], onDelete: Cascade)

  @@unique([asset_id, vulnerability_id])
  @@index([step_id])
  @@map("risk_asset_vuln_links")
}

// Threats are chosen per asset + vulnerability combination (Conformio: "up to 3
// threats per vulnerability-asset combination"); each link becomes one risk.
model RiskVulnThreatLink {
  id              String          @id @default(uuid()) @db.Uuid
  step_id         String          @db.Uuid
  asset_id        String          @db.Uuid
  vulnerability_id String          @db.Uuid
  threat_id       String          @db.Uuid
  created_at      DateTime        @default(now()) @db.Timestamp(6)

  step           ProjectStep      @relation(fields: [step_id], references: [id], onDelete: Cascade)
  asset          RiskAsset        @relation(fields: [asset_id], references: [id], onDelete: Cascade)
  vulnerability  RiskVulnerability @relation(fields: [vulnerability_id], references: [id], onDelete: Cascade)
  threat         RiskThreat       @relation(fields: [threat_id], references: [id], onDelete: Cascade)

  @@unique([asset_id, vulnerability_id, threat_id])
  @@index([step_id])
  @@map("risk_vuln_threat_links")
}

model RiskItem {
  id             String              @id @default(uuid()) @db.Uuid
  step_id        String              @db.Uuid
  asset_id       String              @db.Uuid
  vulnerability_id String            @db.Uuid
  threat_id      String              @db.Uuid

  // Scales follow the Risk Assessment and Treatment Methodology (P2S1):
  // impact and likelihood 0-2, level = impact + likelihood (0-4), 3-4 unacceptable.
  impact         Int?
  likelihood     Int?
  level          Int?
  acceptability  RiskAcceptability?
  risk_owner_id  String?             @db.Uuid
  department     String?             @db.VarChar(200)
  asset_owner_id String?             @db.Uuid
  existing_controls String?          @db.Text
  comment        String?             @db.Text

  discarding     Boolean             @default(false)
  status         RiskStatus          @default(NEW)

  has_incidents  Boolean             @default(false)
  is_reviewed    Boolean             @default(false)
  is_evaluated   Boolean             @default(false)

  treatment_option     TreatmentOption?
  treatment_controls   Json?
  treatment_description String?           @db.Text
  residual_impact      Int?
  residual_likelihood  Int?
  residual_risk        Int?
  treatment_confirmed  Boolean            @default(false)

  approval_decision RiskApprovalDecision @default(PENDING)
  approval_by       String?              @db.Uuid
  approval_at       DateTime?            @db.Timestamp(6)
  approval_comment  String?              @db.Text

  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @updatedAt @db.Timestamp(6)

  step           ProjectStep     @relation(fields: [step_id], references: [id], onDelete: Cascade)
  asset          RiskAsset       @relation(fields: [asset_id], references: [id], onDelete: Cascade)
  vulnerability  RiskVulnerability @relation(fields: [vulnerability_id], references: [id], onDelete: Cascade)
  threat         RiskThreat      @relation(fields: [threat_id], references: [id], onDelete: Cascade)
  risk_owner     User?           @relation("RiskOwners", fields: [risk_owner_id], references: [id], onDelete: SetNull)
  asset_owner    User?           @relation("RiskAssetOwners", fields: [asset_owner_id], references: [id], onDelete: SetNull)
  approval_user  User?           @relation("RiskDecisions", fields: [approval_by], references: [id], onDelete: SetNull)
  treatment_controls_link RiskItemControl[]

  @@unique([step_id, asset_id, vulnerability_id, threat_id])
  @@index([step_id])
  @@index([asset_id])
  @@index([vulnerability_id])
  @@index([threat_id])
  @@index([risk_owner_id])
  @@map("risk_items")
}

model RiskControl {
  id    String @id @default(uuid()) @db.Uuid
  code  String @unique @db.VarChar(20)
  title String @db.VarChar(300)

  item_links RiskItemControl[]

  @@index([code])
  @@map("risk_controls")
}

model RiskItemControl {
  id         String @id @default(uuid()) @db.Uuid
  item_id    String @db.Uuid
  control_id String @db.Uuid
  created_at DateTime @default(now()) @db.Timestamp(6)

  item    RiskItem    @relation(fields: [item_id], references: [id], onDelete: Cascade)
  control RiskControl @relation(fields: [control_id], references: [id], onDelete: Restrict)

  @@unique([item_id, control_id])
  @@index([control_id])
  @@map("risk_item_controls")
}
