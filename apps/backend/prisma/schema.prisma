// ============================================================
// APTISO - Prisma schema (Sprint 1)
// Reference entity model: Documents/entity-diagram.md
// Naming: models PascalCase, columns snake_case (@map)
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum OrganizationRole {
  ORG_OWNER
  ORG_ADMIN
  ORG_MEMBER
}

enum ProjectRole {
  PROJECT_LEAD
  PROJECT_AUDITOR
  PROJECT_MEMBER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum IsoRole {
  TOP_MANAGEMENT
  INFORMATION_SECURITY_MANAGER
  ASSET_OWNER
  DEPARTMENT_HEAD
  IT_ADMINISTRATOR
  INTERNAL_AUDITOR
  EMPLOYEE
}

enum RequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum OrganizationJoinRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum NotificationType {
  ORGANIZATION_JOIN_REQUEST
  TASK_ASSIGNED
  TASK_COMPLETED
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  CERTIFIED
  ON_HOLD
}

enum ProjectPhaseStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum VerificationStatus {
  PENDING
  VERIFIED
  EXPIRED
}

enum PasswordResetStatus {
  PENDING
  USED
  EXPIRED
}

enum AuditAction {
  USER_REGISTERED
  USER_DELETED
  USER_LOGIN
  USER_LOGOUT
  TOKEN_REFRESHED
  EMAIL_VERIFIED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  PASSWORD_CHANGED
  PROFILE_UPDATED
  ORGANIZATION_CREATED
  ORGANIZATION_UPDATED
  ORGANIZATION_DELETED
  PROJECT_CREATED
  PROJECT_UPDATED
  PROJECT_DELETED
  MEMBER_INVITED
  INVITATION_ACCEPTED
  INVITATION_REVOKED
  MEMBER_ADDED
  MEMBER_REMOVED
  MEMBER_ROLE_CHANGED
  PROJECT_MEMBER_ADDED
  PROJECT_MEMBER_REMOVED
  PROJECT_MEMBER_ROLE_CHANGED
  PHASE_UPDATED
  STEP_COMPLETED
  DOCUMENT_CREATED
  DOCUMENT_UPDATED
  DOCUMENT_PUBLISHED
  TASK_ASSIGNED
  TASK_COMPLETED
}

// ============================================================
// USERS & INTERNAL AUTH TABLES
// ============================================================

model User {
  id                String    @id @default(uuid()) @db.Uuid
  email             String    @unique @db.VarChar(150)
  first_name        String    @db.VarChar(100)
  last_name         String    @db.VarChar(100)
  password_hash     String
  avatar_url        String?   @db.VarChar(500)
  bio               String?   @db.Text
  job_title         String?   @db.VarChar(150)
  timezone          String?   @default("UTC") @db.VarChar(50)
  is_active         Boolean   @default(false)
  is_email_verified Boolean   @default(false)
  last_login        DateTime? @db.Timestamp(6)
  created_at        DateTime  @default(now()) @db.Timestamp(6)
  updated_at        DateTime  @updatedAt @db.Timestamp(6)

  // Relations
  organization_memberships           OrganizationMember[]
  project_memberships                ProjectMember[]
  organizations_created              Organization[]            @relation("OrganizationsCreated")
  projects_created                   ComplianceProject[]       @relation("ProjectsCreated")
  invitations_sent                   Invitation[]              @relation("InvitationsSent")
  invitations_accepted               Invitation[]              @relation("InvitationsAccepted")
  member_add_requests_sent           MemberAddRequest[]        @relation("MemberAddRequestsSent")
  member_add_requests_reviewed       MemberAddRequest[]        @relation("MemberAddRequestsReviewed")
  sessions                           Session[]
  email_verifications                EmailVerification[]
  password_resets                    PasswordReset[]
  audit_logs                         AuditLog[]
  organization_join_requests         OrganizationJoinRequest[] @relation("JoinRequestsForUser")
  organization_join_requests_created OrganizationJoinRequest[] @relation("JoinRequestsCreated")
  notifications                      Notification[]
  documents_created                  DocumentInstance[]        @relation("DocumentsCreated")
  doc_last_edited                    DocumentInstance[]        @relation("DocLastEdited")
  doc_owner                          DocumentInstance[]        @relation("DocOwner")
  doc_reviewer                       DocumentInstance[]        @relation("DocReviewer")
  doc_approver                       DocumentInstance[]        @relation("DocApprover")
  doc_versions_published            DocumentVersion[]         @relation("DocVersionPublisher")
  tasks_assigned_to                  TaskAssignment[]          @relation("TasksAssignedTo")
  tasks_assigned_by                  TaskAssignment[]          @relation("TasksAssignedBy")
  requirements_responsible           Requirement[]
  risks_owned                        RiskItem[]             @relation("RiskOwners")
  risk_assets_owned                  RiskItem[]             @relation("RiskAssetOwners")
  risk_decisions                     RiskItem[]             @relation("RiskDecisions")
  soa_controls_responsible           SoaControl[]           @relation("SoaResponsible")
  soa_resource_decisions             SoaControl[]           @relation("SoaResourceDecisions")
  soa_owner_approvals                SoaOwnerApproval[]     @relation("SoaOwnerApprovals")
  soa_approval_decisions             SoaOwnerApproval[]     @relation("SoaApprovalDecisions")

  @@index([email])
  @@map("users")
}

model Session {
  id                 String   @id @default(uuid()) @db.Uuid
  user_id            String   @db.Uuid
  refresh_token_hash String   @unique
  device_name        String?  @db.VarChar(100)
  device_type        String?  @db.VarChar(50)
  ip_address         String?  @db.VarChar(45)
  user_agent         String?
  is_active          Boolean  @default(true)
  last_activity      DateTime @default(now()) @db.Timestamp(6)
  expires_at         DateTime @db.Timestamp(6)
  created_at         DateTime @default(now()) @db.Timestamp(6)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([refresh_token_hash])
  @@index([expires_at])
  @@map("sessions")
}

model EmailVerification {
  id                        String             @id @default(uuid()) @db.Uuid
  user_id                   String             @db.Uuid
  hashed_verification_token String             @unique
  status                    VerificationStatus @default(PENDING)
  expires_at                DateTime           @db.Timestamp(6)
  created_at                DateTime           @default(now()) @db.Timestamp(6)
  updated_at                DateTime           @updatedAt @db.Timestamp(6)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([hashed_verification_token])
  @@map("email_verifications")
}

model PasswordReset {
  id         String              @id @default(uuid()) @db.Uuid
  user_id    String              @db.Uuid
  reset_code String              @db.VarChar(5)
  status     PasswordResetStatus @default(PENDING)
  expires_at DateTime            @db.Timestamp(6)
  attempts   Int                 @default(0)
  created_at DateTime            @default(now()) @db.Timestamp(6)
  updated_at DateTime            @updatedAt @db.Timestamp(6)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, reset_code])
  @@index([user_id, status])
  @@map("password_resets")
}

// ============================================================
// ORGANIZATIONS (multi-tenant)
// ============================================================

model Organization {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(150)
  description String?  @db.Text
  industry    String?  @db.VarChar(100)
  created_by  String   @db.Uuid
  created_at  DateTime @default(now()) @db.Timestamp(6)
  updated_at  DateTime @updatedAt @db.Timestamp(6)

  creator                    User                      @relation("OrganizationsCreated", fields: [created_by], references: [id])
  members                    OrganizationMember[]
  projects                   ComplianceProject[]
  invitations                Invitation[]
  member_add_requests        MemberAddRequest[]
  organization_join_requests OrganizationJoinRequest[]
  notifications              Notification[]

  @@index([name])
  @@map("organizations")
}

model OrganizationMember {
  id              String           @id @default(uuid()) @db.Uuid
  organization_id String           @db.Uuid
  user_id         String           @db.Uuid
  role            OrganizationRole @default(ORG_MEMBER)
  created_at      DateTime         @default(now()) @db.Timestamp(6)
  updated_at      DateTime         @updatedAt @db.Timestamp(6)

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([organization_id, user_id])
  @@index([user_id])
  @@map("organization_members")
}

// ============================================================
// COMPLIANCE PROJECTS (ISO 27001)
// ============================================================

enum FrameworkStatus {
  AVAILABLE
  COMING_SOON
}

model ComplianceFramework {
  id          String          @id @default(uuid()) @db.Uuid
  code        String          @unique @db.VarChar(50)
  name        String          @db.VarChar(150)
  description String?         @db.Text
  version     String?         @db.VarChar(50)
  status      FrameworkStatus @default(COMING_SOON)
  created_at  DateTime        @default(now()) @db.Timestamp(6)
  updated_at  DateTime        @updatedAt @db.Timestamp(6)

  projects ComplianceProject[]

  @@map("compliance_frameworks")
}

model ComplianceProject {
  id                      String        @id @default(uuid()) @db.Uuid
  organization_id         String        @db.Uuid
  name                    String        @db.VarChar(150)
  description             String?       @db.Text
  status                  ProjectStatus @default(PLANNING)
  start_date              DateTime?     @db.Timestamp(6)
  target_date             DateTime?     @db.Timestamp(6)
  compliance_framework_id String        @db.Uuid
  created_by              String        @db.Uuid
  created_at              DateTime      @default(now()) @db.Timestamp(6)
  updated_at              DateTime      @updatedAt @db.Timestamp(6)

  organization         Organization        @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  creator              User                @relation("ProjectsCreated", fields: [created_by], references: [id])
  compliance_framework ComplianceFramework @relation(fields: [compliance_framework_id], references: [id])
  members              ProjectMember[]
  phases               ProjectPhase[]
  invitations          Invitation[]
  member_add_requests  MemberAddRequest[]
  task_assignments     TaskAssignment[]
  notifications        Notification[]
  nonconformities      Nonconformity[]
  incidents            Incident[]
  trainings            Training[]
  security_objectives  SecurityObjective[]
  internal_audits      InternalAudit[]
  review_setup         ManagementReviewSetup?
  management_reviews   ManagementReview[]
  maintenance          MaintenanceSetup?

  @@index([organization_id])
  @@index([status])
  @@map("compliance_projects")
}

model ProjectMember {
  id          String      @id @default(uuid()) @db.Uuid
  project_id  String      @db.Uuid
  user_id     String      @db.Uuid
  privilege   ProjectRole @default(PROJECT_MEMBER) @map("role")
  custom_role String?     @db.VarChar(150)
  joined_at   DateTime    @default(now()) @db.Timestamp(6)
  created_at  DateTime    @default(now()) @db.Timestamp(6)

  project   ComplianceProject      @relation(fields: [project_id], references: [id], onDelete: Cascade)
  user      User                   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  iso_roles ProjectMemberIsoRole[]

  @@unique([project_id, user_id])
  @@index([user_id])
  @@map("project_members")
}

model ProjectMemberIsoRole {
  id                String   @id @default(uuid()) @db.Uuid
  project_member_id String   @db.Uuid
  iso_role          IsoRole
  created_at        DateTime @default(now()) @db.Timestamp(6)

  project_member ProjectMember @relation(fields: [project_member_id], references: [id], onDelete: Cascade)

  @@unique([project_member_id, iso_role])
  @@map("project_member_iso_roles")
}

model MemberAddRequest {
  id              String        @id @default(uuid()) @db.Uuid
  organization_id String        @db.Uuid
  project_id      String        @db.Uuid
  requested_by    String        @db.Uuid
  invited_email   String        @db.VarChar(150)
  privilege       ProjectRole   @default(PROJECT_MEMBER)
  message         String?       @db.Text
  status          RequestStatus @default(PENDING)
  reviewed_by     String?       @db.Uuid
  reviewed_at     DateTime?     @db.Timestamp(6)
  created_at      DateTime      @default(now()) @db.Timestamp(6)
  updated_at      DateTime      @updatedAt @db.Timestamp(6)

  organization Organization      @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  project      ComplianceProject @relation(fields: [project_id], references: [id], onDelete: Cascade)
  requester    User              @relation("MemberAddRequestsSent", fields: [requested_by], references: [id], onDelete: Cascade)
  reviewer     User?             @relation("MemberAddRequestsReviewed", fields: [reviewed_by], references: [id], onDelete: SetNull)

  @@index([organization_id])
  @@index([project_id])
  @@index([status])
  @@map("member_add_requests")
}

model OrganizationJoinRequest {
  id                String                        @id @default(uuid()) @db.Uuid
  organization_id   String                        @db.Uuid
  requested_by      String                        @db.Uuid
  invited_email     String                        @db.VarChar(150)
  requested_user_id String?                       @db.Uuid
  role              OrganizationRole              @default(ORG_MEMBER)
  status            OrganizationJoinRequestStatus @default(PENDING)
  created_at        DateTime                      @default(now()) @db.Timestamp(6)
  updated_at        DateTime                      @updatedAt @db.Timestamp(6)

  organization   Organization   @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  requester      User           @relation("JoinRequestsCreated", fields: [requested_by], references: [id], onDelete: Cascade)
  requested_user User?          @relation("JoinRequestsForUser", fields: [requested_user_id], references: [id], onDelete: SetNull)
  notifications  Notification[]

  @@index([invited_email, status])
  @@index([requested_user_id, status])
  @@map("organization_join_requests")
}

model Notification {
  id                 String           @id @default(uuid()) @db.Uuid
  user_id            String           @db.Uuid
  organization_id    String?          @db.Uuid
  join_request_id    String?          @db.Uuid
  task_assignment_id String?          @db.Uuid
  project_id         String?          @db.Uuid
  type               NotificationType
  read_at            DateTime?        @db.Timestamp(6)
  created_at         DateTime         @default(now()) @db.Timestamp(6)

  user            User                     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  organization    Organization?            @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  join_request    OrganizationJoinRequest? @relation(fields: [join_request_id], references: [id], onDelete: Cascade)
  task_assignment TaskAssignment?          @relation(fields: [task_assignment_id], references: [id], onDelete: Cascade)
  project         ComplianceProject?       @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@index([user_id, read_at])
  @@map("notifications")
}

model ProjectPhase {
  id           String             @id @default(uuid()) @db.Uuid
  project_id   String             @db.Uuid
  name         String             @db.VarChar(150)
  description  String?            @db.Text
  order        Int
  status       ProjectPhaseStatus @default(NOT_STARTED)
  started_at   DateTime?          @db.Timestamp(6)
  completed_at DateTime?          @db.Timestamp(6)
  created_at   DateTime           @default(now()) @db.Timestamp(6)
  updated_at   DateTime           @updatedAt @db.Timestamp(6)

  project ComplianceProject @relation(fields: [project_id], references: [id], onDelete: Cascade)

  steps ProjectStep[]

  @@unique([project_id, order])
  @@index([project_id])
  @@map("project_phases")
}

// ============================================================
// IMPLEMENTATION STEPS & GUIDED DOCUMENTS
// ============================================================

enum StepType {
  EDUCATIONAL
  DOCUMENT
  REGISTER
}

enum StepStatus {
  NOT_STARTED
  COMPLETED
}

enum RequirementType {
  CONTRACTUAL
  LEGAL_REGULATORY
  OTHER
}

enum ComplianceStatus {
  NON_COMPLIANT
  COMPLIANT
}

enum AssetCategory {
  INFRASTRUCTURE
  IT_COMMUNICATION
  SOFTWARE_DATABASE
  DOCUMENTS_DATA
  HUMAN_RESOURCES
  THIRD_PARTY
}

enum ThreatCategory {
  FORCE_MAJEURE
  INTERNAL_OVERSIGHT
  UNINTENTIONAL_MISTAKE
  MALICIOUS_INTENT
  TECHNICAL_ERROR
}

enum RiskStatus {
  NEW
  EDITED
  APPROVED
}

enum RiskAcceptability {
  ACCEPTABLE
  NOT_ACCEPTABLE
}

enum TreatmentOption {
  DECREASE
  TRANSFER
  AVOID
  ACCEPT
}

enum RiskApprovalDecision {
  PENDING
  APPROVED
  REJECTED
}

enum TemplateInputType {
  TEXT
  LONGTEXT
  PERSON
  SELECT
  DATE
}

enum DocumentStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  PUBLISHED
}

enum TaskType {
  WORK_ON_DOCUMENT
  REVIEW_DOCUMENT
  APPROVE_DOCUMENT
  AWARENESS_TASK
  TRAINING_TASK
  HR_REQUEST
  FINANCE_REQUEST
  TECHNOLOGY_REQUEST
  RISK_REVIEW
  IMPLEMENT_CONTROL
  CORRECTIVE_ACTION
  INTERNAL_AUDIT
  MANAGEMENT_REVIEW_ACTION
  MANAGEMENT_REVIEW_DUE
  OBJECTIVES_REVIEW
  DOCUMENT_REVIEW
  INCIDENTS_REVIEW
  TRAININGS_REVIEW
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

model ProjectStep {
  id              String     @id @default(uuid()) @db.Uuid
  phase_id        String     @db.Uuid
  key             String     @db.VarChar(100)
  title           String     @db.VarChar(200)
  purpose         String?    @db.Text
  type            StepType   @default(EDUCATIONAL)
  order           Int
  status          StepStatus @default(NOT_STARTED)
  completed_at    DateTime?  @db.Timestamp(6)
  metadata_json   Json?
  completion_data Json?
  created_at      DateTime   @default(now()) @db.Timestamp(6)
  updated_at      DateTime   @updatedAt @db.Timestamp(6)

  phase             ProjectPhase      @relation(fields: [phase_id], references: [id], onDelete: Cascade)
  document_instance DocumentInstance?
  task_assignments  TaskAssignment[]
  requirements      Requirement[]
  risk_assets       RiskAsset[]
  risk_vulnerabilities RiskVulnerability[]
  risk_threats      RiskThreat[]
  risk_asset_vuln_links RiskAssetVulnLink[]
  risk_vuln_threat_links RiskVulnThreatLink[]
  risks             RiskItem[]
  soa_register      SoaRegister?
  soa_controls      SoaControl[]
  soa_owner_approvals SoaOwnerApproval[]

  @@unique([phase_id, key])
  @@unique([phase_id, order])
  @@index([phase_id])
  @@map("project_steps")
}

model DocumentTemplate {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(200)
  version     String   @default("1.0") @db.VarChar(20)
  description String?  @db.Text
  created_at  DateTime @default(now()) @db.Timestamp(6)
  updated_at  DateTime @updatedAt @db.Timestamp(6)

  questions TemplateQuestion[]
  instances DocumentInstance[]

  @@map("document_templates")
}

model TemplateQuestion {
  id          String            @id @default(uuid()) @db.Uuid
  template_id String            @db.Uuid
  key         String            @db.VarChar(80)
  label       String            @db.VarChar(200)
  help_text   String?           @db.Text
  input_type  TemplateInputType @default(TEXT)
  required    Boolean           @default(false)
  options     Json?
  wizard_page Int
  order       Int
  created_at  DateTime          @default(now()) @db.Timestamp(6)
  updated_at  DateTime          @updatedAt @db.Timestamp(6)

  template DocumentTemplate @relation(fields: [template_id], references: [id], onDelete: Cascade)

  @@unique([template_id, key])
  @@index([template_id, wizard_page, order])
  @@map("template_questions")
}

model DocumentInstance {
  id              String         @id @default(uuid()) @db.Uuid
  template_id     String         @db.Uuid
  step_id         String?        @unique @db.Uuid
  title           String         @db.VarChar(250)
  status          DocumentStatus @default(DRAFT)
  version         String         @default("0.1") @db.VarChar(20)
  content         Json
  answers         Json?
  created_by      String         @db.Uuid
  last_edited_by  String?        @db.Uuid
  owner_id        String?        @db.Uuid
  reviewer_id     String?        @db.Uuid
  approver_id     String?        @db.Uuid
  update_interval Int?
  deadline        DateTime?      @db.Timestamp(6)
  created_at      DateTime       @default(now()) @db.Timestamp(6)
  updated_at      DateTime       @updatedAt @db.Timestamp(6)

  template DocumentTemplate @relation(fields: [template_id], references: [id])
  step     ProjectStep?     @relation(fields: [step_id], references: [id], onDelete: Cascade)
  creator  User             @relation("DocumentsCreated", fields: [created_by], references: [id])
  last_editor User?         @relation("DocLastEdited", fields: [last_edited_by], references: [id], onDelete: SetNull)
  owner    User?            @relation("DocOwner", fields: [owner_id], references: [id], onDelete: SetNull)
  reviewer User?            @relation("DocReviewer", fields: [reviewer_id], references: [id], onDelete: SetNull)
  approver User?            @relation("DocApprover", fields: [approver_id], references: [id], onDelete: SetNull)

  task_assignments TaskAssignment[]
  versions         DocumentVersion[]

  @@index([template_id])
  @@index([created_by])
  @@map("document_instances")
}

// ============================================================
// DOCUMENT VERSIONS & LIBRARY
// ============================================================

model DocumentVersion {
  id              String   @id @default(uuid()) @db.Uuid
  document_id     String   @db.Uuid
  version         String   @db.VarChar(20)
  content         Json
  pdf_data        Bytes?
  published_at    DateTime @default(now()) @db.Timestamp(6)
  published_by    String   @db.Uuid
  notes           String?  @db.VarChar(500)

  document DocumentInstance @relation(fields: [document_id], references: [id], onDelete: Cascade)
  publisher User            @relation("DocVersionPublisher", fields: [published_by], references: [id])

  @@index([document_id])
  @@map("document_versions")
}

// ============================================================
// TASK ASSIGNMENTS & WORKFLOW
// ============================================================

model TaskAssignment {
  id                   String     @id @default(uuid()) @db.Uuid
  project_id           String     @db.Uuid
  step_id              String?    @db.Uuid
  document_instance_id String?    @db.Uuid
  assigned_to          String     @db.Uuid
  assigned_by          String     @db.Uuid
  type                 TaskType
  status               TaskStatus @default(PENDING)
  deadline             DateTime?  @db.Timestamp(6)
  completed_at         DateTime?  @db.Timestamp(6)
  notes                String?    @db.Text
  /// Recurring maintenance activity this task belongs to (e.g. "incidents",
  /// "document:<id>"); an activity never has two open tasks.
  activity_key         String?    @db.VarChar(100)
  created_at           DateTime   @default(now()) @db.Timestamp(6)

  project  ComplianceProject @relation(fields: [project_id], references: [id], onDelete: Cascade)
  step     ProjectStep?      @relation(fields: [step_id], references: [id], onDelete: SetNull)
  document DocumentInstance? @relation(fields: [document_instance_id], references: [id], onDelete: SetNull)
  assignee User              @relation("TasksAssignedTo", fields: [assigned_to], references: [id], onDelete: Cascade)
  assigner User              @relation("TasksAssignedBy", fields: [assigned_by], references: [id], onDelete: Cascade)

  notifications Notification[]

  @@index([assigned_to, status])
  @@index([project_id, type, activity_key])
  @@index([project_id])
  @@index([step_id])
  @@map("task_assignments")
}

// ============================================================
// INVITATIONS (APT-012 / APT-018)
// ============================================================

model Invitation {
  id              String           @id @default(uuid()) @db.Uuid
  organization_id String           @db.Uuid
  project_id      String?          @db.Uuid
  invited_by      String           @db.Uuid
  invited_email   String           @db.VarChar(150)
  role            ProjectRole      @default(PROJECT_MEMBER)
  message         String?          @db.Text
  invite_code     String           @unique @db.VarChar(64)
  hashed_token    String           @unique
  status          InvitationStatus @default(PENDING)
  accepted_by     String?          @db.Uuid
  accepted_at     DateTime?        @db.Timestamp(6)
  expires_at      DateTime         @db.Timestamp(6)
  created_at      DateTime         @default(now()) @db.Timestamp(6)
  updated_at      DateTime         @updatedAt @db.Timestamp(6)

  organization Organization       @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  project      ComplianceProject? @relation(fields: [project_id], references: [id], onDelete: SetNull)
  inviter      User               @relation("InvitationsSent", fields: [invited_by], references: [id], onDelete: Cascade)
  acceptor     User?              @relation("InvitationsAccepted", fields: [accepted_by], references: [id], onDelete: SetNull)

  @@index([invited_email])
  @@index([status])
  @@index([expires_at])
  @@map("invitations")
}

// ============================================================
// AUDIT TRAIL (ActivityLog from entity-diagram)
// ============================================================

model AuditLog {
  id          String      @id @default(uuid()) @db.Uuid
  user_id     String?     @db.Uuid
  action      AuditAction
  entity_type String      @db.VarChar(50)
  entity_id   String?     @db.Uuid
  details     Json?
  ip_address  String?     @db.VarChar(45)
  user_agent  String?
  created_at  DateTime    @default(now()) @db.Timestamp(6)

  user User? @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([user_id])
  @@index([action])
  @@index([created_at])
  @@map("audit_logs")
}

model Requirement {
  id                   String            @id @default(uuid()) @db.Uuid
  step_id              String            @db.Uuid
  requirement_type     RequirementType
  status               ComplianceStatus  @default(NON_COMPLIANT)
  interested_party     String            @db.VarChar(500)
  description          String            @db.Text
  responsible_person_id String           @db.Uuid
  related_area         String?           @db.VarChar(500)
  deadline             DateTime?         @db.Timestamp(6)

  // Contractual & Other
  document_stipulating String?           @db.Text
  date_of_document     DateTime?         @db.Timestamp(6)

  // Legal/Regulatory
  valid_from           DateTime?         @db.Timestamp(6)
  country              String?           @db.VarChar(200)
  state                String?           @db.VarChar(200)
  link                 String?           @db.Text
  law_regulation_name  String?           @db.VarChar(500)

  created_at           DateTime          @default(now()) @db.Timestamp(6)
  updated_at           DateTime          @updatedAt @db.Timestamp(6)

  step                ProjectStep      @relation(fields: [step_id], references: [id], onDelete: Cascade)
  responsible_person  User             @relation(fields: [responsible_person_id], references: [id], onDelete: Restrict)

  @@index([step_id])
  @@map("requirements")
}

// ============================================================
// RISK REGISTER (Phase 2 / Step 2)
// ============================================================

model RiskAsset {
  id        String        @id @default(uuid()) @db.Uuid
  step_id   String        @db.Uuid
  name      String        @db.VarChar(300)
  category  AssetCategory
  is_custom Boolean       @default(false)
  order     Int
  created_at DateTime    @default(now()) @db.Timestamp(6)

  step ProjectStep  @relation(fields: [step_id], references: [id], onDelete: Cascade)
  vuln_links RiskAssetVulnLink[]
  threat_links RiskVulnThreatLink[]
  risks RiskItem[]

  @@unique([step_id, name, category])
  @@index([step_id])
  @@map("risk_assets")
}

model RiskVulnerability {
  id                 String       @id @default(uuid()) @db.Uuid
  step_id            String       @db.Uuid
  name               String       @db.VarChar(300)
  category           AssetCategory
  applicable_controls Json?       @db.Json
  is_custom          Boolean      @default(false)
  created_at         DateTime     @default(now()) @db.Timestamp(6)

  step ProjectStep  @relation(fields: [step_id], references: [id], onDelete: Cascade)
  asset_links RiskAssetVulnLink[]
  threat_links RiskVulnThreatLink[]
  risks RiskItem[]

  @@unique([step_id, name, category])
  @@index([step_id])
  @@map("risk_vulnerabilities")
}

model RiskThreat {
  id                 String       @id @default(uuid()) @db.Uuid
  step_id            String       @db.Uuid
  name               String       @db.VarChar(300)
  threat_category    ThreatCategory
  applicable_controls Json?       @db.Json
  is_custom          Boolean      @default(false)
  created_at         DateTime     @default(now()) @db.Timestamp(6)

  step ProjectStep  @relation(fields: [step_id], references: [id], onDelete: Cascade)
  vuln_links RiskVulnThreatLink[]
  risks RiskItem[]

  @@unique([step_id, name, threat_category])
  @@index([step_id])
  @@map("risk_threats")
}

model RiskAssetVulnLink {
  id              String          @id @default(uuid()) @db.Uuid
  step_id         String          @db.Uuid
  asset_id        String          @db.Uuid
  vulnerability_id String          @db.Uuid
  created_at      DateTime        @default(now()) @db.Timestamp(6)

  step           ProjectStep      @relation(fields: [step_id], references: [id], onDelete: Cascade)
  asset          RiskAsset        @relation(fields: [asset_id], references: [id], onDelete: Cascade)
  vulnerability  RiskVulnerability @relation(fields: [vulnerability_id], references: [id], onDelete: Cascade)

  @@unique([asset_id, vulnerability_id])
  @@index([step_id])
  @@map("risk_asset_vuln_links")
}

// Threats are chosen per asset + vulnerability combination (Conformio: "up to 3
// threats per vulnerability-asset combination"); each link becomes one risk.
model RiskVulnThreatLink {
  id              String          @id @default(uuid()) @db.Uuid
  step_id         String          @db.Uuid
  asset_id        String          @db.Uuid
  vulnerability_id String          @db.Uuid
  threat_id       String          @db.Uuid
  created_at      DateTime        @default(now()) @db.Timestamp(6)

  step           ProjectStep      @relation(fields: [step_id], references: [id], onDelete: Cascade)
  asset          RiskAsset        @relation(fields: [asset_id], references: [id], onDelete: Cascade)
  vulnerability  RiskVulnerability @relation(fields: [vulnerability_id], references: [id], onDelete: Cascade)
  threat         RiskThreat       @relation(fields: [threat_id], references: [id], onDelete: Cascade)

  @@unique([asset_id, vulnerability_id, threat_id])
  @@index([step_id])
  @@map("risk_vuln_threat_links")
}

model RiskItem {
  id             String              @id @default(uuid()) @db.Uuid
  step_id        String              @db.Uuid
  asset_id       String              @db.Uuid
  vulnerability_id String            @db.Uuid
  threat_id      String              @db.Uuid

  // Scales follow the Risk Assessment and Treatment Methodology (P2S1):
  // impact and likelihood 0-2, level = impact + likelihood (0-4), 3-4 unacceptable.
  impact         Int?
  likelihood     Int?
  level          Int?
  acceptability  RiskAcceptability?
  risk_owner_id  String?             @db.Uuid
  department     String?             @db.VarChar(200)
  asset_owner_id String?             @db.Uuid
  existing_controls String?          @db.Text
  comment        String?             @db.Text

  discarding     Boolean             @default(false)
  status         RiskStatus          @default(NEW)

  has_incidents  Boolean             @default(false)
  is_reviewed    Boolean             @default(false)
  is_evaluated   Boolean             @default(false)

  treatment_option     TreatmentOption?
  treatment_controls   Json?
  treatment_description String?           @db.Text
  residual_impact      Int?
  residual_likelihood  Int?
  residual_risk        Int?
  treatment_confirmed  Boolean            @default(false)

  approval_decision RiskApprovalDecision @default(PENDING)
  approval_by       String?              @db.Uuid
  approval_at       DateTime?            @db.Timestamp(6)
  approval_comment  String?              @db.Text

  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @updatedAt @db.Timestamp(6)

  step           ProjectStep     @relation(fields: [step_id], references: [id], onDelete: Cascade)
  asset          RiskAsset       @relation(fields: [asset_id], references: [id], onDelete: Cascade)
  vulnerability  RiskVulnerability @relation(fields: [vulnerability_id], references: [id], onDelete: Cascade)
  threat         RiskThreat      @relation(fields: [threat_id], references: [id], onDelete: Cascade)
  risk_owner     User?           @relation("RiskOwners", fields: [risk_owner_id], references: [id], onDelete: SetNull)
  asset_owner    User?           @relation("RiskAssetOwners", fields: [asset_owner_id], references: [id], onDelete: SetNull)
  approval_user  User?           @relation("RiskDecisions", fields: [approval_by], references: [id], onDelete: SetNull)
  treatment_controls_link RiskItemControl[]

  @@unique([step_id, asset_id, vulnerability_id, threat_id])
  @@index([step_id])
  @@index([asset_id])
  @@index([vulnerability_id])
  @@index([threat_id])
  @@index([risk_owner_id])
  @@map("risk_items")
}

model RiskControl {
  id    String @id @default(uuid()) @db.Uuid
  code  String @unique @db.VarChar(20)
  title String @db.VarChar(300)

  item_links RiskItemControl[]
  soa_rows   SoaControl[]

  @@index([code])
  @@map("risk_controls")
}

model RiskItemControl {
  id         String @id @default(uuid()) @db.Uuid
  item_id    String @db.Uuid
  control_id String @db.Uuid
  created_at DateTime @default(now()) @db.Timestamp(6)

  item    RiskItem    @relation(fields: [item_id], references: [id], onDelete: Cascade)
  control RiskControl @relation(fields: [control_id], references: [id], onDelete: Restrict)

  @@unique([item_id, control_id])
  @@index([control_id])
  @@map("risk_item_controls")
}

// ============================================================
// STATEMENT OF APPLICABILITY + RISK TREATMENT PLAN (Phase 2 / Step 3)
// ============================================================

enum ControlImplementationStatus {
  IMPLEMENTED
  UNDERWAY
  PLANNED
  REVIEW_NEEDED
}

/// One per SoA step: setup answers and the Risk Treatment Plan confirmation.
model SoaRegister {
  id                 String    @id @default(uuid()) @db.Uuid
  step_id            String    @unique @db.Uuid
  setup              Json?
  setup_completed_at DateTime? @db.Timestamp(6)
  rtp_confirmed_at   DateTime? @db.Timestamp(6)
  created_at         DateTime  @default(now()) @db.Timestamp(6)
  updated_at         DateTime  @updatedAt @db.Timestamp(6)

  step ProjectStep @relation(fields: [step_id], references: [id], onDelete: Cascade)

  @@map("soa_registers")
}

/// One row per Annex A control: applicability (SoA) and treatment plan (RTP).
model SoaControl {
  id                    String                       @id @default(uuid()) @db.Uuid
  step_id               String                       @db.Uuid
  control_id            String                       @db.Uuid
  applicable            Boolean?
  justification         String?                      @db.Text
  implementation_method String?                      @db.Text
  status                ControlImplementationStatus?
  /// Platform suggestion: { applicable, justification, sources: { risks[], requirements[], setup } }
  suggestion            Json?
  is_user_edited        Boolean                      @default(false)

  // Risk Treatment Plan (applicable controls not yet implemented)
  responsible_id        String?                      @db.Uuid
  deadline              DateTime?                    @db.Timestamp(6)
  resources             String?                      @db.Text
  resources_decision    RiskApprovalDecision?
  resources_comment     String?                      @db.Text
  resources_decided_by  String?                      @db.Uuid
  resources_decided_at  DateTime?                    @db.Timestamp(6)
  task_id               String?                      @db.Uuid

  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @updatedAt @db.Timestamp(6)

  step              ProjectStep @relation(fields: [step_id], references: [id], onDelete: Cascade)
  control           RiskControl @relation(fields: [control_id], references: [id], onDelete: Restrict)
  responsible       User?       @relation("SoaResponsible", fields: [responsible_id], references: [id], onDelete: SetNull)
  resources_decider User?       @relation("SoaResourceDecisions", fields: [resources_decided_by], references: [id], onDelete: SetNull)

  @@unique([step_id, control_id])
  @@index([step_id])
  @@map("soa_controls")
}

/// Risk owners' approval of the Risk Treatment Plan and residual risks (clause 6.1.3 f).
model SoaOwnerApproval {
  id          String               @id @default(uuid()) @db.Uuid
  step_id     String               @db.Uuid
  user_id     String               @db.Uuid
  decision    RiskApprovalDecision @default(PENDING)
  comment     String?              @db.Text
  decided_by  String?              @db.Uuid
  decided_at  DateTime?            @db.Timestamp(6)
  created_at  DateTime             @default(now()) @db.Timestamp(6)
  updated_at  DateTime             @updatedAt @db.Timestamp(6)

  step    ProjectStep @relation(fields: [step_id], references: [id], onDelete: Cascade)
  user    User        @relation("SoaOwnerApprovals", fields: [user_id], references: [id], onDelete: Cascade)
  decider User?       @relation("SoaApprovalDecisions", fields: [decided_by], references: [id], onDelete: SetNull)

  @@unique([step_id, user_id])
  @@map("soa_owner_approvals")
}

// ============================================================
// PHASE 4: PREPARATION FOR EXTERNAL AUDIT
// People are stored as user ids and validated as project members by the
// services (the project member list resolves their names).
// ============================================================

enum NonconformityStatus {
  UNASSIGNED
  ASSIGNED
  ACTIONS_DEFINED
  RESOLVED
  NOT_RELEVANT
}

enum FindingSource {
  INTERNAL_AUDIT
  EXTERNAL_AUDIT
  INCIDENT
  MANAGEMENT_REVIEW
  EMPLOYEE
  SUPPLIER
  OTHER
}

enum ActionStatus {
  PLANNED
  IN_PROGRESS
  DONE
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
}

enum IncidentStatus {
  REPORTED
  ASSESSED
  RESOLVED
  CLOSED
}

enum TrainingStatus {
  PROPOSED
  APPROVED
  SCHEDULED
  PERFORMED
  CANCELLED
}

enum ObjectiveType {
  TOP_LEVEL
  OPERATIONAL
}

enum ReviewFrequency {
  MONTHLY
  QUARTERLY
  SEMI_ANNUALLY
  YEARLY
}

enum ObjectiveStatus {
  DRAFT
  APPROVED
}

enum AuditStatus {
  PLANNED
  IN_PROGRESS
  REPORTED
  APPROVED
}

enum AuditResult {
  CONFORMING
  MINOR_NONCONFORMITY
  MAJOR_NONCONFORMITY
  OBSERVATION
  NOT_AUDITED
}

enum ManagementReviewStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
}

enum ReviewDecisionType {
  IMPROVEMENT
  ISMS_CHANGE
  RESOURCES
  OTHER
}

/// Clauses 10.1 / 10.2: nonconformities and their corrective actions.
model Nonconformity {
  id                        String              @id @default(uuid()) @db.Uuid
  project_id                String              @db.Uuid
  number                    Int
  title                     String              @db.VarChar(300)
  description               String              @db.Text
  source                    FindingSource       @default(OTHER)
  detected_on               DateTime            @db.Timestamp(6)
  reported_by               String              @db.Uuid
  responsible_id            String?             @db.Uuid
  status                    NonconformityStatus @default(UNASSIGNED)
  correction                String?             @db.Text
  root_cause                String?             @db.Text
  effectiveness_review      String?             @db.Text
  effectiveness_verified_by String?             @db.Uuid
  effectiveness_verified_at DateTime?           @db.Timestamp(6)
  not_relevant_reason       String?             @db.Text
  closed_at                 DateTime?           @db.Timestamp(6)
  audit_item_id             String?             @unique @db.Uuid
  incident_id               String?             @db.Uuid
  created_at                DateTime            @default(now()) @db.Timestamp(6)
  updated_at                DateTime            @updatedAt @db.Timestamp(6)

  project    ComplianceProject   @relation(fields: [project_id], references: [id], onDelete: Cascade)
  audit_item AuditChecklistItem? @relation(fields: [audit_item_id], references: [id], onDelete: SetNull)
  incident   Incident?           @relation(fields: [incident_id], references: [id], onDelete: SetNull)
  actions    CorrectiveAction[]

  @@unique([project_id, number])
  @@index([project_id, status])
  @@map("nonconformities")
}

model CorrectiveAction {
  id               String       @id @default(uuid()) @db.Uuid
  nonconformity_id String       @db.Uuid
  description      String       @db.Text
  responsible_id   String       @db.Uuid
  due_date         DateTime?    @db.Timestamp(6)
  status           ActionStatus @default(PLANNED)
  completed_at     DateTime?    @db.Timestamp(6)
  task_id          String?      @db.Uuid
  created_at       DateTime     @default(now()) @db.Timestamp(6)
  updated_at       DateTime     @updatedAt @db.Timestamp(6)

  nonconformity Nonconformity @relation(fields: [nonconformity_id], references: [id], onDelete: Cascade)

  @@index([nonconformity_id])
  @@map("corrective_actions")
}

/// Controls A.5.24-A.5.28 and A.6.8: information security events and incidents.
model Incident {
  id                      String           @id @default(uuid()) @db.Uuid
  project_id              String           @db.Uuid
  number                  Int
  title                   String           @db.VarChar(300)
  description             String           @db.Text
  occurred_at             DateTime         @db.Timestamp(6)
  reported_at             DateTime         @default(now()) @db.Timestamp(6)
  reported_by             String           @db.Uuid
  responsible_id          String?          @db.Uuid
  affects_confidentiality Boolean          @default(false)
  affects_integrity       Boolean          @default(false)
  affects_availability    Boolean          @default(false)
  severity                IncidentSeverity @default(LOW)
  status                  IncidentStatus   @default(REPORTED)
  is_security_incident    Boolean?
  assessment              String?          @db.Text
  response                String?          @db.Text
  lessons_learned         String?          @db.Text
  evidence                String?          @db.Text
  closed_at               DateTime?        @db.Timestamp(6)
  created_at              DateTime         @default(now()) @db.Timestamp(6)
  updated_at              DateTime         @updatedAt @db.Timestamp(6)

  project         ComplianceProject @relation(fields: [project_id], references: [id], onDelete: Cascade)
  nonconformities Nonconformity[]

  @@unique([project_id, number])
  @@map("incidents")
}

/// Clause 7.2 / A.6.3: training plan and record.
model Training {
  id              String         @id @default(uuid()) @db.Uuid
  project_id      String         @db.Uuid
  title           String         @db.VarChar(300)
  skills          String         @db.Text
  method          String?        @db.VarChar(200)
  provider        String?        @db.VarChar(200)
  planned_date    DateTime?      @db.Timestamp(6)
  performed_date  DateTime?      @db.Timestamp(6)
  status          TrainingStatus @default(PROPOSED)
  participant_ids Json
  evidence        String?        @db.Text
  effectiveness   String?        @db.Text
  source_step_id  String?        @db.Uuid
  source_key      String?        @db.VarChar(200)
  approved_by     String?        @db.Uuid
  approved_at     DateTime?      @db.Timestamp(6)
  created_by      String         @db.Uuid
  created_at      DateTime       @default(now()) @db.Timestamp(6)
  updated_at      DateTime       @updatedAt @db.Timestamp(6)

  project ComplianceProject @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@unique([project_id, source_key])
  @@map("trainings")
}

/// Clauses 6.2 / 9.1: information security objectives and their measurement.
model SecurityObjective {
  id             String          @id @default(uuid()) @db.Uuid
  project_id     String          @db.Uuid
  order          Int
  title          String          @db.Text
  type           ObjectiveType   @default(TOP_LEVEL)
  action_plan    String?         @db.Text
  resources      String?         @db.Text
  responsible_id String?         @db.Uuid
  due_date       DateTime?       @db.Timestamp(6)
  measurement    String?         @db.Text
  frequency      ReviewFrequency @default(YEARLY)
  status         ObjectiveStatus @default(DRAFT)
  approved_by    String?         @db.Uuid
  approved_at    DateTime?       @db.Timestamp(6)
  created_at     DateTime        @default(now()) @db.Timestamp(6)
  updated_at     DateTime        @updatedAt @db.Timestamp(6)

  project      ComplianceProject      @relation(fields: [project_id], references: [id], onDelete: Cascade)
  measurements ObjectiveMeasurement[]

  @@index([project_id])
  @@map("security_objectives")
}

model ObjectiveMeasurement {
  id           String   @id @default(uuid()) @db.Uuid
  objective_id String   @db.Uuid
  measured_on  DateTime @db.Timestamp(6)
  result       String   @db.Text
  achieved     Boolean
  comment      String?  @db.Text
  recorded_by  String   @db.Uuid
  created_at   DateTime @default(now()) @db.Timestamp(6)

  objective SecurityObjective @relation(fields: [objective_id], references: [id], onDelete: Cascade)

  @@index([objective_id])
  @@map("objective_measurements")
}

/// Clause 9.2: internal audit programme, checklist and findings.
model InternalAudit {
  id              String      @id @default(uuid()) @db.Uuid
  project_id      String      @db.Uuid
  title           String      @db.VarChar(300)
  scope           String      @db.Text
  criteria        String      @db.Text
  start_date      DateTime    @db.Timestamp(6)
  end_date        DateTime    @db.Timestamp(6)
  lead_auditor_id String      @db.Uuid
  auditees        String?     @db.Text
  status          AuditStatus @default(PLANNED)
  conclusion      String?     @db.Text
  approved_by     String?     @db.Uuid
  approved_at     DateTime?   @db.Timestamp(6)
  task_id         String?     @db.Uuid
  created_at      DateTime    @default(now()) @db.Timestamp(6)
  updated_at      DateTime    @updatedAt @db.Timestamp(6)

  project ComplianceProject    @relation(fields: [project_id], references: [id], onDelete: Cascade)
  items   AuditChecklistItem[]

  @@index([project_id])
  @@map("internal_audits")
}

model AuditChecklistItem {
  id          String       @id @default(uuid()) @db.Uuid
  audit_id    String       @db.Uuid
  order       Int
  ref         String       @db.VarChar(20)
  requirement String       @db.VarChar(300)
  question    String       @db.Text
  result      AuditResult?
  evidence    String?      @db.Text
  updated_at  DateTime     @updatedAt @db.Timestamp(6)

  audit         InternalAudit  @relation(fields: [audit_id], references: [id], onDelete: Cascade)
  nonconformity Nonconformity?

  @@unique([audit_id, ref])
  @@map("audit_checklist_items")
}

/// Clauses 5.1 / 9.3: what top management reviews, and how often.
model ManagementReviewSetup {
  id               String          @id @default(uuid()) @db.Uuid
  project_id       String          @unique @db.Uuid
  frequency        ReviewFrequency @default(YEARLY)
  next_review_date DateTime?       @db.Timestamp(6)
  reviewer_ids     Json
  items            Json
  configured_at    DateTime?       @db.Timestamp(6)
  created_at       DateTime        @default(now()) @db.Timestamp(6)
  updated_at       DateTime        @updatedAt @db.Timestamp(6)

  project ComplianceProject @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@map("management_review_setups")
}

/// Clause 9.3: a management review meeting, its inputs and decisions (minutes).
model ManagementReview {
  id              String                 @id @default(uuid()) @db.Uuid
  project_id      String                 @db.Uuid
  title           String                 @db.VarChar(300)
  review_date     DateTime               @db.Timestamp(6)
  participant_ids Json
  status          ManagementReviewStatus @default(PLANNED)
  conclusions     String?                @db.Text
  completed_at    DateTime?              @db.Timestamp(6)
  created_by      String                 @db.Uuid
  created_at      DateTime               @default(now()) @db.Timestamp(6)
  updated_at      DateTime               @updatedAt @db.Timestamp(6)

  project   ComplianceProject          @relation(fields: [project_id], references: [id], onDelete: Cascade)
  inputs    ManagementReviewInput[]
  decisions ManagementReviewDecision[]

  @@index([project_id])
  @@map("management_reviews")
}

model ManagementReviewInput {
  id         String   @id @default(uuid()) @db.Uuid
  review_id  String   @db.Uuid
  order      Int
  item_key   String   @db.VarChar(20)
  title      String   @db.VarChar(300)
  summary    String   @db.Text
  notes      String?  @db.Text
  discussed  Boolean  @default(false)
  updated_at DateTime @updatedAt @db.Timestamp(6)

  review ManagementReview @relation(fields: [review_id], references: [id], onDelete: Cascade)

  @@unique([review_id, item_key])
  @@map("management_review_inputs")
}

model ManagementReviewDecision {
  id             String             @id @default(uuid()) @db.Uuid
  review_id      String             @db.Uuid
  type           ReviewDecisionType @default(IMPROVEMENT)
  description    String             @db.Text
  responsible_id String?            @db.Uuid
  due_date       DateTime?          @db.Timestamp(6)
  status         ActionStatus       @default(PLANNED)
  task_id        String?            @db.Uuid
  completed_at   DateTime?          @db.Timestamp(6)
  created_at     DateTime           @default(now()) @db.Timestamp(6)
  updated_at     DateTime           @updatedAt @db.Timestamp(6)

  review ManagementReview @relation(fields: [review_id], references: [id], onDelete: Cascade)

  @@index([review_id])
  @@map("management_review_decisions")
}

// ============================================================
// PHASE 5: ISMS MAINTENANCE & CERTIFICATION CYCLE
// ============================================================

/// Certification cycle dates and the frequency of the recurring reviews.
/// Everything else on the maintenance page is derived from the ISMS modules.
model MaintenanceSetup {
  id                        String          @id @default(uuid()) @db.Uuid
  project_id                String          @unique @db.Uuid
  certification_date        DateTime?       @db.Timestamp(6)
  certification_body        String?         @db.VarChar(200)
  certificate_number        String?         @db.VarChar(100)
  incident_review_frequency ReviewFrequency @default(QUARTERLY)
  training_review_frequency ReviewFrequency @default(YEARLY)
  last_run_at               DateTime?       @db.Timestamp(6)
  created_at                DateTime        @default(now()) @db.Timestamp(6)
  updated_at                DateTime        @updatedAt @db.Timestamp(6)

  project ComplianceProject @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@map("maintenance_setups")
}
