# ============================================================
# APTISO backend environment template
# Copy to apps/backend/.env
# ============================================================

# --- App ---
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
FRONTEND_URL=http://localhost:3000

# --- Database (docker compose: aptiso-postgres) ---
DATABASE_URL=postgresql://aptiso:aptiso@localhost:5432/aptiso?schema=public

# --- Auth / JWT ---
JWT_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- CSRF (in-memory store; use Redis in production) ---
CSRF_SECRET=change-me-csrf-secret-at-least-32-chars

# --- Mail (Mailhog in dev) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_NAME=APTISO
EMAIL_FROM=no-reply@aptiso.local

# --- Storage connectors (mirror of the document library to a drive) ---
# Public address of this backend, used for the Google sign-in redirect:
#   <BACKEND_PUBLIC_URL>/<API_PREFIX>/connectors/google/callback
BACKEND_PUBLIC_URL=http://localhost:4000
# Encrypts the stored drive access (at least 32 characters). Without it, connectors are disabled.
CONNECTOR_SECRET_KEY=
# Google Cloud > APIs & Services > Credentials > OAuth client (Web application); enable the Google Drive API.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Evidence files (default: apps/backend/storage/evidence; back this folder up with the database) ---
# EVIDENCE_STORAGE_DIR=
