# Shared secret with the backend (apps/backend/.env AI_SERVICE_TOKEN), at least 32 characters.
AI_SERVICE_TOKEN=
# The AI service's own database (role aptiso_ai, see scripts/create-database.sql).
AI_DB_PASSWORD=
AI_DB_USER=aptiso_ai
AI_DB_HOST=localhost
AI_DB_PORT=5432
AI_DB_NAME=aptiso_ai
REDIS_URL=redis://localhost:6379

# NVIDIA Build (https://build.nvidia.com/). Models can be changed here without code changes.
NVIDIA_API_KEY=
AI_BASE_URL=https://integrate.api.nvidia.com/v1
AI_MODEL_MAIN=nvidia/nemotron-3-super-120b-a12b
AI_MODEL_FALLBACK=openai/gpt-oss-20b
AI_MODEL_EMBED=nvidia/nemotron-3-embed-1b
AI_MODEL_OCR=nvidia/nemotron-parse-2.0
AI_MODEL_VISION=meta/llama-3.2-90b-vision-instruct
